{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "agent",
  "projectType": "application",
  "sourceRoot": "apps/agent",
  "tags": ["lang:go", "scope:agent"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o dist/agent ./...",
        "cwd": "apps/agent"
      },
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/agent"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./...",
        "cwd": "apps/agent"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./...",
        "cwd": "apps/agent"
      },
      "cache": true,
      "inputs": ["default"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go vet ./...",
        "cwd": "apps/agent"
      },
      "cache": true,
      "inputs": ["default"]
    }
  }
}
