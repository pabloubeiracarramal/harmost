{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "agent",
  "projectType": "application",
  "sourceRoot": "apps/agent",
  "tags": ["lang:go", "scope:agent"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -o dist/agent ./cmd/agent",
        "cwd": "apps/agent"
      },
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/agent"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/agent run",
        "cwd": "apps/agent"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./...",
        "cwd": "apps/agent"
      },
      "cache": true,
      "inputs": ["default"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go vet ./...",
        "cwd": "apps/agent"
      },
      "cache": true,
      "inputs": ["default"]
    },
    "pair": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/agent pair",
        "cwd": "apps/agent"
      }
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/agent install",
        "cwd": "apps/agent"
      }
    },
    "uninstall": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/agent uninstall",
        "cwd": "apps/agent"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/agent start",
        "cwd": "apps/agent"
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run ./cmd/agent stop",
        "cwd": "apps/agent"
      }
    }
  }
}
